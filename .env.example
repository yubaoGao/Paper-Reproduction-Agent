DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
PRIMARY_MODEL=deepseek-v4-pro
FAST_MODEL=qwen3.6-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Production composition (API and worker are independent processes)
REPROPILOT_DATABASE_URL=
REPROPILOT_WORKSPACE_ROOT=workspace
REPROPILOT_API_HOST=127.0.0.1
REPROPILOT_API_PORT=8000
REPROPILOT_WORKER_ID=
REPROPILOT_BASE_IMAGE_DIGEST=
REPROPILOT_RUN_LOG_ROOT=logs/runs
REPROPILOT_DOCKER_VOLUME_DRIVER=
# Example: {"researcher":["D:\\datasets"]}
REPROPILOT_PRINCIPAL_RESOURCE_ROOTS_JSON={}

# Optional filtered provisioning network; configure both or neither.
REPROPILOT_PROVISIONING_NETWORK_ID=
REPROPILOT_PROVISIONING_NETWORK_NAME=
